PORT=3000
NODE_ENV=production
# 全应用默认东八区（本地开发建议设置；Docker 已在 compose/Dockerfile 配置）
TZ=Asia/Shanghai
DB_ROOT_PASSWORD=your_secure_password
DB_NAME=my_project_db
JWT_SECRET=change_me_in_production

# 并发控制（可选）
CONCURRENCY_LIMIT_ENABLED=true
API_CONCURRENCY_MAX=50
AI_CONCURRENCY_MAX=8
DB_CONNECTION_LIMIT=20

# selfAPP_AIAgent（备忘落库点评等代调；场景 AI 已迁出）
AGENT_BASE_URL=http://localhost:8000
AGENT_API_KEY=zhengjiaxin
AGENT_TIMEOUT_MS=120000

# TrendRadar 通用 Webhook 回调校验（回调 URL 上 ?token=；留空则不校验）
TRENDRADAR_WEBHOOK_TOKEN=

# 服务器同步脚本调 POST /api/news/import 时使用的 Bearer 令牌
NEWS_IMPORT_TOKEN=
