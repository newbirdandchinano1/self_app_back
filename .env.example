PORT=3000
NODE_ENV=production
# 全应用默认东八区（本地开发建议设置；Docker 已在 compose/Dockerfile 配置）
TZ=Asia/Shanghai
DB_ROOT_PASSWORD=your_secure_password
DB_NAME=my_project_db
JWT_SECRET=change_me_in_production

# 并发控制（阶段 A：与前端 timeout 同灰度）
CONCURRENCY_LIMIT_ENABLED=true
# 全局并发帽（分池开启时为跨池总帽；旧默认 50，灰度 12）
API_CONCURRENCY_MAX=12
AI_CONCURRENCY_MAX=8
# 分池（PAGE_CONCURRENCY_LIMIT_ENABLED=false 时退回单池 API_CONCURRENCY_MAX）
PAGE_CONCURRENCY_LIMIT_ENABLED=true
API_LIGHT_CONCURRENCY_MAX=16
API_PAGE_CONCURRENCY_MAX=6
API_SYNC_CONCURRENCY_MAX=4
API_WRITE_CONCURRENCY_MAX=6
# 单身份并发；0=关闭
API_USER_CONCURRENCY_MAX=4

# 连接池（禁止为掩盖过载直接扩到 50）
DB_CONNECTION_LIMIT=20
# 等待连接队列上限；0=无限（禁止生产）；满则 503
DB_QUEUE_LIMIT=50
# 获取连接超时 ms；超时 503 + Retry-After
DB_ACQUIRE_TIMEOUT_MS=3000

# 阶段 B1：拒绝无 taskView 的危险大 bootstrap（事件/打卡/多表）；false=只告警不拒绝
TASKS_DANGEROUS_BOOTSTRAP_REJECT=true

# 阶段 C：进程内缓存 + bootstrap-v2（默认关；可先于前端消费上线）
CACHE_ENABLED=true
CACHE_CATALOG_TTL_MS=60000
CACHE_CATALOG_SWR_MS=30000
CACHE_HEATMAP_TTL_MS=60000
CACHE_HEATMAP_SWR_MS=30000
CACHE_DAY_BOUNDARY_TTL_MS=300000
CACHE_DAY_BOUNDARY_SWR_MS=60000
CACHE_BOOTSTRAP_V2_TTL_MS=15000
CACHE_BOOTSTRAP_V2_SWR_MS=15000
CACHE_SINGLE_FLIGHT_MAX_WAIT_MS=8000
TASKS_BOOTSTRAP_V2_ENABLED=false

# 阶段 E：灰度见 scripts/phase-e-gray-checklist.md
# mobile 同灰度：EXPO_PUBLIC_TASKS_MODULE_LOADING_ENABLED（默认开；设 0 回滚）
# 禁止 PHASE_E_BACKEND_ONLY_LIMIT=1 上线（对照实验应失败）

# TrendRadar 通用 Webhook 回调校验（回调 URL 上 ?token=；留空则不校验）
TRENDRADAR_WEBHOOK_TOKEN=

# 服务器同步脚本调 POST /api/news/import 时使用的 Bearer 令牌
NEWS_IMPORT_TOKEN=

# 业务后端代调 selfAPP_AIAgent（备忘 AI 点评等）
# 容器内请填宿主机/Agent 可达地址，勿用 localhost
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_API_KEY=
AGENT_TIMEOUT_MS=120000

# 外部 API：和风天气（控制台 API Host + KEY；默认位置成都）
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_TIMEOUT_MS=15000
QWEATHER_DEFAULT_LAT=30.57
QWEATHER_DEFAULT_LNG=104.07
QWEATHER_DEFAULT_LABEL=成都

# 外部 API：万维易源 ShowAPI 星座运势（872-1）
SHOWAPI_APP_KEY=
SHOWAPI_TIMEOUT_MS=15000
SHOWAPI_BASE_URL=https://route.showapi.com
SHOWAPI_HOROSCOPE_PATH=/872-1
